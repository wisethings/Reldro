generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  COMPANY_ADMIN
  EMPLOYEE
  SPECIALIST
  PLATFORM_ADMIN
}

enum SubscriptionTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AssessmentType {
  ORGANIZATION
  EMPLOYEE
}

enum AssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
}

enum ComplexityLevel {
  LOW
  MEDIUM
  HIGH
}

enum OpportunityStatus {
  IDENTIFIED
  PLANNED
  IN_PROGRESS
  IMPLEMENTED
  DEFERRED
}

enum WorkflowAdoptionStatus {
  NOT_ADOPTED
  LEARNING
  PILOT
  IN_PROGRESS
  ADOPTED
  OPTIMIZING
  COMPLETE
}

enum InitiativeStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum ProjectStage {
  DISCOVERY
  WORKFLOW_DESIGN
  IMPLEMENTATION
  TRAINING
  LAUNCH
  MEASUREMENT
  OPTIMIZATION
}

enum ProjectStatus {
  OPEN
  PROPOSED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum SpecialistTagType {
  INDUSTRY
  FUNCTION
  TOOL
  CERTIFICATION
}

enum PriceType {
  HOURLY
  PROJECT
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  OVERDUE
}

enum TransactionStatus {
  PENDING
  RELEASED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Core tenancy & identity
// ---------------------------------------------------------------------------

model Organization {
  id                         String   @id @default(cuid())
  name                       String
  industry                   String
  size                       String // e.g. "1-50", "51-200", "201-1000", "1000+"
  revenueRange               String
  geography                  String
  businessModel              String
  goals                      String[] // selected AI goals from onboarding
  logoUrl                    String?
  onboardingStep             Int      @default(0)
  onboardingDone             Boolean  @default(false)
  // When true, an employee only sees their own department's workflows and
  // lessons (both the shared global catalog and other departments' team-
  // authored content are filtered out for them) - a company admin always
  // sees everything regardless of this setting.
  departmentIsolationEnabled Boolean  @default(false)
  // What this org's own admin says an hour of employee time actually costs,
  // fully loaded - used to turn measured/estimated time saved into a dollar
  // figure for THIS company instead of a single number assumed for every
  // customer. Defaults to a reasonable blended estimate until an admin sets
  // their own in Settings.
  blendedHourlyRate          Float    @default(45)
  // Shown to every reporter before they submit; the company's own emergency instructions.
  emergencyInstructions      String   @default("")
  // True only for the clearly labeled sample workspace. Never set for a customer workspace.
  isDemo                     Boolean  @default(false)
  // How many people (admins and employees) Reldro has agreed this workspace may have. null = no limit set.
  seatLimit                  Int?
  // Set by Reldro staff to lock a workspace. Nobody in it can sign in until it is cleared.
  suspendedAt                DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  departments                  Department[]
  certificationTypes           CertificationType[]
  employees                    Employee[]
  users                        User[]
  assessments                  Assessment[]
  learningPaths                LearningPath[]
  opportunities                Opportunity[]
  initiatives                  Initiative[]
  organizationWorkflows        OrganizationWorkflow[]
  projects                     Project[]
  integrationConnections       IntegrationConnection[]
  aiUsageEvents                AIUsageEvent[]
  adoptionSnapshots            AdoptionMetricSnapshot[]
  roiMetrics                   ROIMetric[]
  subscription                 Subscription?
  invoices                     Invoice[]
  auditLogs                    AuditLog[]
  pointsRules                  PointsRule[]
  pointsTransactions           PointsTransaction[]
  rewardItems                  RewardItem[]
  recognitions                 Recognition[]
  reviews                      Review[]
  customTools                  Tool[]
  organizationTools            OrganizationTool[]
  demoRequests                 DemoRequest[]
  courses                      Course[]
  workflows                    Workflow[]
  templates                    Template[]
  hiddenContent                HiddenContent[]
  sites                        Site[]
  incidents                    IncidentResponse[]
  safetyReports                SafetyReport[]
  correctiveActions            CorrectiveAction[]
  inspectionTemplates          InspectionTemplate[]
  inspections                  Inspection[]
  toolboxTalks                 ToolboxTalk[]
  qualifications               Qualification[]
  escalationRules              EscalationRule[]
  workflowChecklistCompletions WorkflowChecklistCompletion[]
  workflowLinks                WorkflowLink[]
  workflowDependencies         WorkflowDependency[]
  workflowTimeSavedLogs        WorkflowTimeSavedLog[]

  @@index([industry])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  // Pain-point keys (see src/lib/data/painPoints.ts) the admin flagged for
  // this department during onboarding - what actually informed which
  // opportunities got created, kept for reference.
  painPoints     String[]     @default([])

  employees     Employee[]
  opportunities Opportunity[]

  @@unique([organizationId, name])
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  name           String
  role           Role
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  hasSeenTour         Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // null = invited but has never logged in (an invite still pending).
  lastLoginAt         DateTime?
  // Two-factor sign-in (Reldro staff accounts). The secret is stored encrypted; the step blocks re-using a code.
  totpSecret          String?
  totpEnabledAt       DateTime?
  totpLastStep        Int?

  employee          Employee?
  specialist        Specialist?
  notifications     Notification[]
  sentMessages      Message[]
  auditLogs         AuditLog[]
  recognitionsGiven Recognition[]

  @@index([organizationId])
}

model Employee {
  id                 String       @id @default(cuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id])
  jobTitle           String
  isDepartmentAdmin  Boolean      @default(false)
  // Cross-department content visibility, independent of role/department
  // admin status - same effect department isolation gives a company admin
  // (sees every department's opportunities/templates/workflows/lessons),
  // granted to a specific employee instead. Meant for a demo persona who
  // needs to show breadth across departments, not a real permission tier.
  viewAllDepartments Boolean      @default(false)
  // Frontline safety: the site (jobsite/shop) this person normally works at,
  // and whether they are on the safety team (sees every report/investigation).
  siteId             String?
  isSafetyLead       Boolean      @default(false)
  aiFluencyScore     Int?
  hireDate           DateTime     @default(now())
  createdAt          DateTime     @default(now())

  assessments             Assessment[]
  employeeSkills          EmployeeSkill[]
  lessonCompletions       LessonCompletion[]
  simulationAttempts      SimulationAttempt[]
  initiativeMembers       InitiativeMember[]
  aiUsageEvents           AIUsageEvent[]
  workflowStepCompletions WorkflowStepCompletion[]
  ownedWorkflows          OrganizationWorkflow[]   @relation("WorkflowOwner")
  assignedWorkflows       OrganizationWorkflow[]   @relation("WorkflowAssignee")
  workflowTimeSavedLogs   WorkflowTimeSavedLog[]
  certifications          EmployeeCertification[]
  pointsTransactions      PointsTransaction[]
  rewardRedemptions       RewardRedemption[]
  recognitionsReceived    Recognition[]
  projectMemberships      ProjectMember[]

  @@index([organizationId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Specialists / marketplace
// ---------------------------------------------------------------------------

model Specialist {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline                 String
  bio                      String
  photoUrl                 String?
  yearsExperience          Int
  hourlyRate               Int?
  projectRateMin           Int?
  projectRateMax           Int?
  availability             String // e.g. "Available now", "2 weeks out", "Booked"
  ratingAvg                Float    @default(0)
  ratingCount              Int      @default(0)
  completedProjects        Int      @default(0)
  approved                 Boolean  @default(false)
  featured                 Boolean  @default(false)
  location                 String?
  linkedinUrl              String?
  portfolioUrl             String?
  notableProjects          String?
  preferredEngagementTypes String[] @default([])
  createdAt                DateTime @default(now())

  tags     SpecialistTag[]
  services SpecialistService[]
  projects Project[]
  reviews  Review[]

  @@index([approved])
}

model SpecialistTag {
  id           String            @id @default(cuid())
  specialistId String
  specialist   Specialist        @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  type         SpecialistTagType
  value        String

  @@index([specialistId])
  @@index([type, value])
}

model SpecialistService {
  id           String     @id @default(cuid())
  specialistId String
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  name         String
  description  String
  priceType    PriceType
  price        Int

  @@index([specialistId])
}

// ---------------------------------------------------------------------------
// Assessments & skills
// ---------------------------------------------------------------------------

model Assessment {
  id             String           @id @default(cuid())
  type           AssessmentType
  status         AssessmentStatus @default(NOT_STARTED)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  overallScore   Int?
  scoreBreakdown Json? // { literacy: 72, usage: 43, ... }
  completedAt    DateTime?
  createdAt      DateTime         @default(now())

  responses AssessmentResponse[]

  @@index([organizationId])
  @@index([employeeId])
}

model AssessmentResponse {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  category     String
  questionKey  String
  questionText String
  score        Int // normalized 0-100

  @@index([assessmentId])
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  category String // e.g. "AI Literacy", "Prompting", "Workflow Design"

  employeeSkills EmployeeSkill[]
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  score      Int

  @@unique([employeeId, skillId])
}

// ---------------------------------------------------------------------------
// Learning
// ---------------------------------------------------------------------------

model LearningPath {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String
  department     String? // target department, null = all
  roleLevel      String? // e.g. "Individual Contributor", "Manager"
  createdAt      DateTime      @default(now())

  courses Course[]

  @@index([organizationId])
}

model Course {
  id             String        @id @default(cuid())
  learningPathId String?
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: SetNull)
  title          String        @unique
  description    String
  department     String
  workflowId     String?
  workflow       Workflow?     @relation(fields: [workflowId], references: [id])
  order          Int           @default(0)
  role           String? // e.g. "Account Executives" - who this path is for
  skills         String[]      @default([]) // EmployeeSkillCategory keys this path develops
  tools          String[]      @default([]) // real tools this path teaches (ChatGPT, Salesforce, ...)
  // null = shared global catalog course (seeded); set = a team-authored course, visible only within that org.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByName  String        @default("") // denormalized display name of the admin/manager who authored it

  lessons Lesson[]

  @@index([learningPathId])
  @@index([organizationId])
}

enum LessonType {
  CONCEPT
  DEMONSTRATION
  INTERACTIVE_EXERCISE
  TOOL_PRACTICE
  PROMPT_EXERCISE
  DECISION_EXERCISE
  KNOWLEDGE_CHECK
  REFLECTION
  WORKFLOW_PRACTICE
}

model Lesson {
  id                         String     @id @default(cuid())
  courseId                   String
  course                     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title                      String
  type                       LessonType @default(CONCEPT)
  objective                  String     @default("") // "What you'll be able to do"
  whyItMatters               String     @default("") // connects the skill to the employee's actual work
  concept                    String // "Learn": short practical explanation
  example                    String // "See it": an expert applying the skill
  tryItPrompt                String     @default("") // "Try it": instructions for the employee to perform the task
  evaluatePrompt             String     @default("") // "Evaluate": an AI output or decision to assess
  exercise                   String // "Apply": connect the skill to the employee's actual workflow
  knowledgeCheckQuestion     String     @default("")
  knowledgeCheckOptions      String[]   @default([])
  knowledgeCheckCorrectIndex Int        @default(-1)
  takeaway                   String     @default("") // one concise principle to remember
  skills                     String[]   @default([]) // EmployeeSkillCategory keys this lesson develops
  order                      Int        @default(0)
  durationMin                Int        @default(8)
  imageUrl                   String? // optional illustrative image (screenshot, diagram) - a data URI for team-authored lessons
  videoUrl                   String? // optional video link (YouTube, Loom, Vimeo) - embedded on the lesson page

  completions LessonCompletion[]

  @@index([courseId])
}

model LessonCompletion {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score       Int?
  completedAt DateTime @default(now())

  @@unique([employeeId, lessonId])
}

model Simulation {
  id          String          @id @default(cuid())
  title       String          @unique
  department  String
  scenario    String // final open-ended reasoning prompt
  description String
  difficulty  ComplexityLevel @default(MEDIUM)

  // Briefing (shown before the employee starts)
  role             String   @default("") // "Your Role"
  objective        String   @default("")
  availableTools   String[] @default([])
  companyPolicy    String   @default("")
  workflowNote     String   @default("") // approved process to follow
  constraints      String   @default("")
  successCriteria  String   @default("")
  timeLimitMinutes Int?

  // Step 1: decision point with branching consequences
  decisionPrompt  String @default("")
  decisionOptions Json   @default("[]") // {id,label,quality:"strong"|"partial"|"weak",consequence}[]

  // Step 2: evaluate a realistic AI output for planted issues
  aiOutputSample String @default("")
  aiOutputIssues Json   @default("[]") // {id,label,present:boolean}[]

  // Debrief: revealed only after the attempt
  expertApproach String   @default("")
  skills         String[] @default([]) // EmployeeSkillCategory keys this simulation develops

  attempts SimulationAttempt[]
}

model SimulationAttempt {
  id                String     @id @default(cuid())
  employeeId        String
  employee          Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  simulationId      String
  simulation        Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  score             Int
  feedback          String
  dimensions        Json       @default("{}") // {reasoning,aiUsage,promptQuality,accuracy,workflowAdherence}
  decisionChoiceId  String?
  evaluationChoices String[]   @default([])
  passed            Boolean    @default(false)
  completedAt       DateTime   @default(now())

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Workflows
// ---------------------------------------------------------------------------

model Workflow {
  id               String          @id @default(cuid())
  title            String
  department       String
  industryTags     String[]
  summary          String
  currentProcess   String
  aiProcess        String
  timeSavedMinutes Int
  difficulty       ComplexityLevel @default(MEDIUM)
  skillLevel       String          @default("Intermediate")
  toolsRequired    String[]
  skillsRequired   String[]
  securityNotes    String?
  trainingNotes    String?
  createdAt        DateTime        @default(now())
  // null = shared global catalog workflow (seeded); set = a team-authored workflow, visible only within that org.
  organizationId   String?
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByName    String          @default("") // denormalized display name of the admin/manager who authored it

  steps                 WorkflowStep[]
  opportunities         Opportunity[]
  organizationWorkflows OrganizationWorkflow[]
  courses               Course[]
  projects              Project[]
  checklistCompletions  WorkflowChecklistCompletion[]
  linksAsSource         WorkflowLink[]                @relation("WorkflowLinkSource")
  linksAsTarget         WorkflowLink[]                @relation("WorkflowLinkTarget")
  dependenciesRequired  WorkflowDependency[]          @relation("DependentWorkflow")
  dependenciesBlocking  WorkflowDependency[]          @relation("PrerequisiteWorkflow")
  timeSavedLogs         WorkflowTimeSavedLog[]

  @@index([department])
  @@index([organizationId])
}

model WorkflowStep {
  id              String   @id @default(cuid())
  workflowId      String
  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  description     String
  aiPrompt        String?
  humanCheckpoint Boolean  @default(false)
  imageUrl        String?
  videoUrl        String?

  completions WorkflowStepCompletion[]

  @@index([workflowId])
}

model WorkflowStepCompletion {
  id             String       @id @default(cuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workflowStepId String
  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  completedAt    DateTime     @default(now())

  @@unique([employeeId, workflowStepId])
  @@index([workflowStepId])
}

model OrganizationWorkflow {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow               @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status         WorkflowAdoptionStatus @default(NOT_ADOPTED)
  adoptedAt      DateTime?
  usersAdopted   Int                    @default(0)
  ownerId        String?
  owner          Employee?              @relation("WorkflowOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Distinct from owner: who's actively doing the implementation work right
  // now, vs. who's accountable for the rollout overall - the same
  // owner/assignee split Jira draws between a ticket's owner and assignee.
  // Anyone can assign this to themselves; assigning someone else is a
  // company-admin/department-lead action, same boundary as owner.
  assigneeId     String?
  assignee       Employee?              @relation("WorkflowAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([organizationId, workflowId])
  @@index([ownerId])
  @@index([assigneeId])
}

// Tracks real completion of the Workflow detail page's "Implementation
// checklist" - itemIndex is the item's position in that page's fixed
// checklist array (see workflows/[id]/page.tsx), not a separate catalog,
// since the checklist itself is generated from the workflow rather than
// author-defined.
model WorkflowChecklistCompletion {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId      String
  workflow        Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  itemIndex       Int
  completedByName String
  completedAt     DateTime     @default(now())

  @@unique([organizationId, workflowId, itemIndex])
  @@index([organizationId, workflowId])
}

// An org-defined association between two workflows, shown on both workflows'
// detail pages for context/discovery (e.g. an intake workflow linked to the
// triage workflow it usually feeds into). Purely informational - unlike
// WorkflowDependency, it never gates adoption. Org-scoped like
// OrganizationWorkflow, since the underlying Workflow rows can be shared
// global-catalog content that no single org owns. Undirected: creating a
// link stores both directions so it shows up from either workflow's page
// without an OR query, and removing one side removes both.
model WorkflowLink {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId       String
  workflow         Workflow     @relation("WorkflowLinkSource", fields: [workflowId], references: [id], onDelete: Cascade)
  linkedWorkflowId String
  linkedWorkflow   Workflow     @relation("WorkflowLinkTarget", fields: [linkedWorkflowId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@unique([organizationId, workflowId, linkedWorkflowId])
  @@index([organizationId, workflowId])
}

// A prerequisite: for this org, `workflow` shouldn't be marked adopted until
// `dependsOnWorkflow` already is. Directed and org-scoped, since the same
// global-catalog workflow can have different real-world prerequisites at
// different companies (e.g. one company's CRM rollout gates its sales-email
// workflow, another's doesn't).
model WorkflowDependency {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId          String
  workflow            Workflow     @relation("DependentWorkflow", fields: [workflowId], references: [id], onDelete: Cascade)
  dependsOnWorkflowId String
  dependsOnWorkflow   Workflow     @relation("PrerequisiteWorkflow", fields: [dependsOnWorkflowId], references: [id], onDelete: Cascade)
  createdAt           DateTime     @default(now())

  @@unique([organizationId, workflowId, dependsOnWorkflowId])
  @@index([organizationId, workflowId])
  @@index([organizationId, dependsOnWorkflowId])
}

// A real, employee-reported time-saved figure for one workflow, replacing
// the catalog's flat editorial guess (Workflow.timeSavedMinutes) with actual
// measured data once enough of it exists. One row per (employee, workflow):
// prompted the first time an employee finishes every step of a workflow, and
// they can resubmit later to update their own estimate rather than get
// re-prompted every time. Org-scoped like the other org/workflow join
// models, since the underlying Workflow can be shared global-catalog
// content that no single org owns.
model WorkflowTimeSavedLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  minutesSaved   Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([employeeId, workflowId])
  @@index([organizationId, workflowId])
}

// ---------------------------------------------------------------------------
// Opportunities & initiatives
// ---------------------------------------------------------------------------

model Opportunity {
  id                     String            @id @default(cuid())
  organizationId         String
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId           String?
  department             Department?       @relation(fields: [departmentId], references: [id])
  workflowId             String?
  workflow               Workflow?         @relation(fields: [workflowId], references: [id])
  title                  String
  currentProcess         String
  aiOpportunity          String
  impact                 ImpactLevel
  complexity             ComplexityLevel
  estHoursSavedMonthly   Int
  estAnnualValue         Int
  status                 OpportunityStatus @default(IDENTIFIED)
  recommendedSpecialist  Boolean           @default(false)
  businessImpactScore    Int // 0-100
  adoptionPotentialScore Int // 0-100
  frequencyScore         Int // 0-100
  riskScore              Int // 0-100
  toolsRequired          String[]
  createdAt              DateTime          @default(now())

  initiativeWorkflows InitiativeWorkflow[]
  projects            Project[]

  @@index([organizationId])
  @@index([departmentId])
}

model Initiative {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  goalDescription String
  startDate       DateTime
  endDate         DateTime
  departments     String[]
  status          InitiativeStatus @default(PLANNED)
  kpis            Json // [{ label, baseline, current, target, unit }]
  createdAt       DateTime         @default(now())

  members   InitiativeMember[]
  workflows InitiativeWorkflow[]

  @@index([organizationId])
}

model InitiativeMember {
  id               String     @id @default(cuid())
  initiativeId     String
  initiative       Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleOnInitiative String     @default("Contributor")

  @@unique([initiativeId, employeeId])
}

model InitiativeWorkflow {
  id            String       @id @default(cuid())
  initiativeId  String
  initiative    Initiative   @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([initiativeId])
}

// ---------------------------------------------------------------------------
// Projects (specialist implementation workspace)
// ---------------------------------------------------------------------------

model Project {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  specialistId   String?
  specialist     Specialist?   @relation(fields: [specialistId], references: [id])
  workflowId     String?
  workflow       Workflow?     @relation(fields: [workflowId], references: [id])
  opportunityId  String?
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id])
  title          String
  description    String
  stage          ProjectStage  @default(DISCOVERY)
  status         ProjectStatus @default(OPEN)
  budget         Int?
  ccEmails       String[]      @default([])
  startDate      DateTime?
  targetEndDate  DateTime?
  createdAt      DateTime      @default(now())

  tasks        ProjectTask[]
  milestones   ProjectMilestone[]
  deliverables ProjectDeliverable[]
  messages     Message[]
  reviews      Review[]
  transactions MarketplaceTransaction[]
  members      ProjectMember[]

  @@index([organizationId])
  @@index([specialistId])
}

model ProjectMember {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleOnProject String   @default("Contributor")
  addedAt       DateTime @default(now())

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
}

model ProjectTask {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    TaskStatus @default(TODO)
  assignee  String?
  dueDate   DateTime?
  order     Int        @default(0)

  @@index([projectId])
}

model ProjectMilestone {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime
  completed Boolean      @default(false)
  stage     ProjectStage

  @@index([projectId])
}

model ProjectDeliverable {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  url        String
  uploadedAt DateTime @default(now())

  @@index([projectId])
}

model Message {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderUserId String
  senderUser   User     @relation(fields: [senderUserId], references: [id])
  body         String
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model Review {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specialistId   String
  specialist     Specialist   @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String
  createdAt      DateTime     @default(now())

  @@index([specialistId])
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model Integration {
  id          String @id @default(cuid())
  key         String @unique // e.g. "google_workspace"
  name        String
  category    String
  description String
  logoKey     String // used for icon lookup client-side

  connections IntegrationConnection[]
}

model IntegrationConnection {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationId       String
  integration         Integration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  status              IntegrationStatus @default(DISCONNECTED)
  lastSyncAt          DateTime?
  connectedAt         DateTime?
  mockData            Json?
  accessToken         String?
  externalAccountId   String?
  externalAccountName String?

  @@unique([organizationId, integrationId])
}

// ---------------------------------------------------------------------------
// Tool library - governance over the actual tools/platforms employees use,
// distinct from Integration (which is about connecting a service's data in).
// A Tool with organizationId = null is part of the shared global catalog;
// one with organizationId set is a custom tool a specific org added (e.g.
// an internal platform).
// ---------------------------------------------------------------------------

enum ToolCategory {
  AI_ASSISTANT
  CRM
  ERP
  PRODUCTIVITY
  DESIGN
  DEVELOPMENT
  COMMUNICATION
  ANALYTICS
  CUSTOMER_SERVICE
  FINANCE
  HR
  INTERNAL_PLATFORM
  OTHER
}

enum ToolApprovalStatus {
  APPROVED
  RECOMMENDED
  UNDER_REVIEW
  RESTRICTED
  DEPRECATED
}

model Tool {
  id             String        @id @default(cuid())
  name           String        @unique
  category       ToolCategory
  vendor         String?
  description    String
  capabilities   String[]
  isCustom       Boolean       @default(false)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  organizationTools OrganizationTool[]

  @@index([organizationId])
}

model OrganizationTool {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toolId         String
  tool           Tool               @relation(fields: [toolId], references: [id], onDelete: Cascade)
  status         ToolApprovalStatus @default(UNDER_REVIEW)
  addedAt        DateTime           @default(now())
  guidance       String?
  approvedUses   String[]           @default([])
  restrictedUses String[]           @default([])

  @@unique([organizationId, toolId])
}

// ---------------------------------------------------------------------------
// Telemetry / analytics / ROI
// ---------------------------------------------------------------------------

model AIUsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id])
  tool           String
  eventType      String
  sourceId       String? // e.g. the specific WorkflowStep/Template id a "template_copied" event was copied from
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, eventType, sourceId])
}

model AdoptionMetricSnapshot {
  id                       String       @id @default(cuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department               String? // null = org-wide
  month                    DateTime // first of month
  activeUsers              Int
  totalUsers               Int
  adoptionPct              Int
  hoursSavedMonthly        Int
  aiAdoptionScore          Int
  literacyScore            Int
  usageScore               Int
  workflowIntegrationScore Int
  governanceScore          Int
  measurementScore         Int
  leadershipScore          Int

  @@unique([organizationId, department, month])
  @@index([organizationId])
}

model ROIMetric {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowLabel  String
  month          DateTime
  investment     Int
  annualValue    Int

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier                 SubscriptionTier   @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  seats                Int                @default(25)
  pricePerMonth        Int
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount          Int
  status          InvoiceStatus @default(OPEN)
  issuedAt        DateTime      @default(now())
  dueAt           DateTime
  description     String
  stripeInvoiceId String?       @unique

  @@index([organizationId])
}

model MarketplaceTransaction {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount      Int
  platformFee Int
  status      TransactionStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Notifications & audit
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Certification
// ---------------------------------------------------------------------------

// Global certification definitions (like the global Tool/Simulation catalogs) - real, checkable requirements against data already tracked elsewhere.
model Certification {
  id                   String   @id @default(cuid())
  key                  String   @unique
  title                String
  description          String
  minFluency           Int? // required overall AI fluency score
  requiredSkills       Json     @default("[]") // {skill: EmployeeSkillCategory, minScore: number}[]
  minCoursesCompleted  Int      @default(0) // fully-completed learning paths, any department
  minSimulationsPassed Int      @default(0) // distinct simulations with at least one passed attempt
  pointsAwarded        Int      @default(0)
  order                Int      @default(0)
  createdAt            DateTime @default(now())

  employeeCertifications EmployeeCertification[]
}

model EmployeeCertification {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  earnedAt        DateTime      @default(now())

  @@unique([employeeId, certificationId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Rewards
// ---------------------------------------------------------------------------

enum RewardCategory {
  GIFT_CARD
  LEARNING_CREDIT
  MERCHANDISE
  PTO
  DONATION
  EXPERIENCE
  CUSTOM
}

enum RedemptionStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
}

enum RecognitionType {
  PEER
  MANAGER
}

enum RecognitionCategory {
  AI_ADOPTION
  WORKFLOW_INNOVATION
  LEARNING
  BUSINESS_IMPACT
  COLLABORATION
  AI_LEADERSHIP
}

// Company-controlled point amounts per behavior - the only thing admins can tune; which behaviors exist is fixed (see POINTS_RULE_DEFAULTS).
model PointsRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String // e.g. "course_completed" - matches a real trigger in the codebase
  label          String
  points         Int
  enabled        Boolean      @default(true)
  monthlyCap     Int? // max number of payouts of this rule per employee per month

  @@unique([organizationId, key])
}

// Append-only ledger - an employee's point balance is always the sum of their transactions, never a separately stored (and driftable) number.
model PointsTransaction {
  id             String       @id @default(cuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount         Int // positive = earned, negative = redeemed
  reason         String
  ruleKey        String?
  entityType     String?
  entityId       String?
  createdAt      DateTime     @default(now())

  @@index([employeeId])
  @@index([organizationId])
}

model RewardItem {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String
  category       RewardCategory
  pointCost      Int
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())

  redemptions RewardRedemption[]

  @@index([organizationId])
}

model RewardRedemption {
  id           String           @id @default(cuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rewardItemId String
  rewardItem   RewardItem       @relation(fields: [rewardItemId], references: [id], onDelete: Cascade)
  pointCost    Int // snapshot at redemption time
  status       RedemptionStatus @default(PENDING)
  requestedAt  DateTime         @default(now())
  resolvedAt   DateTime?

  @@index([employeeId])
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
}

// Sales-led signup: a prospect submits this from the public marketing site;
// a platform admin reviews it and provisions the organization from
// platform-admin, rather than the prospect self-registering.
model DemoRequest {
  id             String            @id @default(cuid())
  name           String
  email          String
  companyName    String
  companySize    String?
  message        String?
  status         DemoRequestStatus @default(NEW)
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([status])
}

// A standalone AI prompt an admin/department lead writes directly, distinct
// from a Template that's really just a WorkflowStep's aiPrompt surfaced on
// the Templates page - this exists for a prompt worth sharing with the team
// that isn't naturally part of a documented step-by-step workflow.
model Template {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     String
  title          String
  prompt         String
  tools          String[]     @default([])
  createdByName  String       @default("")
  imageUrl       String?
  videoUrl       String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// An org admin "deleting" a shared-catalog item (workflow, course, tool,
// simulation, or a catalog workflow step surfaced as a template). The catalog
// rows are shared by every organization, so deleting them would remove them
// for everyone - this records a per-org removal instead, which every catalog
// read filters out. entityType: WORKFLOW | COURSE | TOOL | SIMULATION | TEMPLATE.
model HiddenContent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  hiddenByName   String       @default("")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId, entityType])
}

// Fixed-window rate limiting for unauthenticated endpoints (e.g. the public
// specialist application form). No Redis/queue in this stack, so this is a
// deliberately simple DB-backed counter - see src/lib/rateLimit.ts.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Recognition {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUserId     String
  fromUser       User                @relation(fields: [fromUserId], references: [id], onDelete: Cascade)
  toEmployeeId   String
  toEmployee     Employee            @relation(fields: [toEmployeeId], references: [id], onDelete: Cascade)
  type           RecognitionType
  category       RecognitionCategory
  message        String
  pointsAwarded  Int                 @default(0)
  createdAt      DateTime            @default(now())

  @@index([toEmployeeId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Frontline safety operations
//
// Statuses, categories and severities are plain strings on purpose: the
// allowed values live in src/lib/safety/pack.ts (a "workflow pack" per
// industry), so adding an adjacent industry is configuration, not a schema
// migration.
// ---------------------------------------------------------------------------

model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String       @default("")
  kind           String       @default("JOBSITE") // JOBSITE | SHOP | YARD
  active         Boolean      @default(true)
  safetyLeadId   String? // Employee who receives reports for this site by default
  createdAt      DateTime     @default(now())

  reports     SafetyReport[]
  inspections Inspection[]

  @@index([organizationId])
}

model SafetyReport {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number                Int // human-friendly per-organization sequence (SR-0012)
  type                  String // HAZARD | NEAR_MISS | INJURY | EQUIPMENT | CONCERN
  category              String
  title                 String
  description           String
  transcript            String? // raw voice-note text, kept so a person can compare with the structured version
  siteId                String?
  site                  Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  occurredAt            DateTime
  severity              String // LOW | MEDIUM | HIGH | CRITICAL
  status                String       @default("NEW") // NEW | ASSIGNED | INVESTIGATING | ACTIONS_OPEN | CLOSED
  privacy               String       @default("NAMED") // NAMED | CONFIDENTIAL | ANONYMOUS
  injuryInvolved        Boolean      @default(false)
  immediateAction       String       @default("")
  attachments           Json         @default("[]") // [{ name, dataUri }]
  reporterId            String? // Employee id; null when anonymous
  ownerId               String? // Employee id currently responsible
  respondBy             DateTime? // from the escalation rule that matched at creation
  acknowledgedAt        DateTime? // when the owner first acknowledged the report
  aiAssisted            Boolean      @default(false)
  closedAt              DateTime?
  locationNote          String       @default("") // free-text "where exactly", also used when the site is unknown
  severityConfirmedAt   DateTime? // null = severity is still a suggestion; set when a responder confirms or changes it
  severityConfirmedById String?
  followUpHash          String?      @unique // SHA-256 of the private case code (anonymous reports only)
  inspectionId          String? // set when the report was raised from a failed inspection item
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  events        ReportEvent[]
  investigation Investigation?
  actions       CorrectiveAction[]
  incident      IncidentResponse?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([siteId])
}

model ReportEvent {
  id          String       @id @default(cuid())
  reportId    String
  report      SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type        String // CREATED | ASSIGNED | ACKNOWLEDGED | STATUS | COMMENT | ESCALATED | INVESTIGATION | ACTION | AI_DRAFT
  message     String
  actorName   String       @default("")
  actorId     String?
  restricted  Boolean      @default(false) // safety-team-only note
  toReporter  Boolean      @default(false) // a message the reporter is meant to read (shown on their report or private follow-up page)
  attachments Json         @default("[]") // [{ name, dataUri }] evidence added to the timeline
  createdAt   DateTime     @default(now())

  @@index([reportId])
}

// The response workspace for an event that needs a coordinated response. It is a mode of the
// report (one row per report), not a second record of the same event.
model IncidentResponse {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportId        String       @unique
  report          SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status          String       @default("ACTIVE") // ACTIVE | MONITORING | RESOLVED
  leadId          String? // Employee id of the response lead
  summary         String       @default("") // current situation, written by responders
  nextAction      String       @default("")
  nextActionDueAt DateTime?
  closeoutSummary String       @default("")
  standDownReason String       @default("") // set when responders decide it was not an incident
  openedBy        String       @default("MANUAL") // MANUAL | RULE
  openedById      String? // Employee id who opened it (null when opened by a rule)
  openedAt        DateTime     @default(now())
  resolvedAt      DateTime?
  updatedAt       DateTime     @updatedAt

  responders IncidentResponder[]

  @@index([organizationId, status])
}

model IncidentResponder {
  id         String           @id @default(cuid())
  incidentId String
  incident   IncidentResponse @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  employeeId String
  role       String           @default("") // free text, e.g. "Site lead", "Medical liaison"
  addedAt    DateTime         @default(now())

  @@unique([incidentId, employeeId])
  @@index([employeeId])
}

model Investigation {
  id                  String       @id @default(cuid())
  reportId            String       @unique
  report              SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  organizationId      String
  status              String       @default("OPEN") // OPEN | IN_REVIEW | COMPLETE
  leadId              String? // Employee id
  facts               String       @default("")
  sequenceNotes       String       @default("") // what happened, in order
  contributingFactors String[]     @default([])
  rootCauseNotes      String       @default("") // written by a person; never auto-filled
  lessonText          String       @default("") // de-identified lesson approved for sharing
  shareLesson         Boolean      @default(false)
  openedAt            DateTime     @default(now())
  completedAt         DateTime?

  statements InvestigationStatement[]
  questions  InvestigationQuestion[]

  @@index([organizationId])
}

model InvestigationStatement {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  providedBy      String // a role label ("Journeyman electrician"), not necessarily a name
  content         String
  addedByName     String        @default("")
  createdAt       DateTime      @default(now())

  @@index([investigationId])
}

model InvestigationQuestion {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  text            String
  answer          String        @default("")
  aiDrafted       Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([investigationId])
}

model CorrectiveAction {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number          Int
  reportId        String?
  report          SafetyReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  inspectionId    String?
  title           String
  description     String        @default("")
  priority        String        @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status          String        @default("PROPOSED") // PROPOSED | APPROVED | IN_PROGRESS | COMPLETED | VERIFIED | CANCELLED
  ownerId         String? // Employee id
  dueDate         DateTime?
  proposedById    String?
  approvedById    String?
  approvedAt      DateTime?
  completionNotes String        @default("")
  evidence        Json          @default("[]") // [{ name, dataUri }]
  completedAt     DateTime?
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([reportId])
}

model InspectionTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           String       @default("SITE_INSPECTION") // SITE_INSPECTION | READINESS | OBSERVATION
  items          Json         @default("[]") // [{ id, label, critical }]
  frequencyDays  Int? // when set, completing one schedules the next
  createdAt      DateTime     @default(now())

  inspections Inspection[]

  @@index([organizationId])
}

model Inspection {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assigneeId     String? // Employee id
  dueDate        DateTime
  status         String             @default("SCHEDULED") // SCHEDULED | COMPLETED
  results        Json               @default("[]") // [{ itemId, label, result: PASS | FAIL | NA, note }]
  notes          String             @default("")
  completedById  String?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())

  @@index([organizationId, status])
  @@index([siteId])
}

model ToolboxTalk {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  topic          String       @default("")
  content        String
  sourceMaterial String       @default("") // company-approved text the outline was drafted from
  siteId         String? // null = company-wide
  scheduledFor   DateTime
  aiDrafted      Boolean      @default(false)
  createdByName  String       @default("")
  createdAt      DateTime     @default(now())

  acknowledgements TalkAcknowledgement[]

  @@index([organizationId])
}

model TalkAcknowledgement {
  id             String      @id @default(cuid())
  talkId         String
  talk           ToolboxTalk @relation(fields: [talkId], references: [id], onDelete: Cascade)
  employeeId     String
  acknowledgedAt DateTime    @default(now())

  @@unique([talkId, employeeId])
}

model Qualification {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId        String
  name              String // "OSHA 30", "Aerial lift", "First aid / CPR"
  typeId            String? // catalog entry this record counts toward; null for a free-text record
  type              CertificationType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  certificateNumber String             @default("")
  issuingBody       String             @default("")
  notes             String             @default("")
  issuedOn          DateTime?
  expiresOn         DateTime?
  verifiedAt        DateTime? // a safety lead checked the certificate itself
  verifiedById      String? // User id of whoever verified it
  createdAt         DateTime           @default(now())

  @@index([organizationId])
  @@index([employeeId])
  @@index([typeId])
}

/// The certifications an organization tracks (OSHA 30, aerial lift, ...) and who must hold each one.
model CertificationType {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  category        String          @default("") // free label such as "Safety training" or "Equipment operation"
  issuingBody     String          @default("")
  validityMonths  Int? // null = does not expire; used to suggest an expiry date when a record is added
  requiredScope   String          @default("NONE") // NONE | ALL | SELECTED
  requiredSiteIds String[] // with SELECTED: people at these sites must hold it
  requiredCrewIds String[] // with SELECTED: people in these crews must hold it
  createdAt       DateTime        @default(now())
  qualifications  Qualification[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model EscalationRule {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  minSeverity        String // rule applies at this severity or higher
  category           String? // null = any category
  siteId             String? // null = any site
  ownerId            String? // Employee assigned when the rule matches (else the site's safety lead)
  respondWithinHours Int          @default(24)
  escalateToId       String? // Employee alerted when nobody has acknowledged in time
  openIncident       Boolean      @default(false) // open the incident workspace automatically when this rule matches
  createdAt          DateTime     @default(now())

  @@index([organizationId])
}
