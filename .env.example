# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reldro"

# Session signing secret (generate a long random string in production)
AUTH_SECRET="change-this-to-a-long-random-string"

# Optional: enable a language model for AI-assisted drafts (report structuring,
# investigation questions, summaries, toolbox-talk outlines). When unset, the
# same features run from built-in checklists and label their output that way.
# Set AI_PROVIDER to "anthropic" or "openai" along with the matching key.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_PROVIDER="mock"

# Optional: enable real outbound email via Resend (lib/email.ts). When unset,
# email sends no-op. EMAIL_FROM must be a verified sending domain in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Reldro <noreply@reldro.com>"

# The app's own public origin (no trailing slash), used for links embedded
# in outbound emails and the Slack OAuth redirect URI. Deliberately not
# inferred from the incoming request's Host header - see getAppUrl() in
# lib/email.ts for why. Defaults to the production domain if unset; set this
# for local dev (e.g. "http://localhost:3000") so those links are correct.
APP_URL=""

